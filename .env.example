# Copy this file to .env and choose your own password.
# .env is private: it is in .gitignore and must never be uploaded.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# Optional: card payments with Stripe (TEST mode only).
# Get it from dashboard.stripe.com → Developers → API keys → "Secret key" (starts with sk_test_)
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
